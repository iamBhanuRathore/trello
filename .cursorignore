# ─── Secrets — AI must never read real env files ──────────────────────────────
**/.env
**/.env.development
**/.env.production
**/.env.local
**/.env.*.local
!**/*.example

# ─── Large Lockfiles & Generated Bundles ──────────────────────────────────────
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Large Database Migration Snapshots ───────────────────────────────────────
# Prevents AI from reading 40,000+ lines of raw JSON schema diffs
apps/backend/src/db/migrations/meta/**

# ─── Large Graphify Artifacts ────────────────────────────────────────────────
# Preserves GRAPH_REPORT.md for AI reading while blocking 2.5MB raw JSON graph
graphify-out/graph.json
graphify-out/.graphify_analysis.json
graphify-out/cache/**
graphify-out/202*/**

# ─── Build Artifacts & Caches ────────────────────────────────────────────────
dist/**
build/**
.turbo/**
.next/**
out/**
coverage/**
*.tsbuildinfo
*.log

# ─── Media & Binary Blobs ────────────────────────────────────────────────────
*.svg
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.pdf
*.zip
