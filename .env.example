# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace these with long random strings in your actual .env
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=replace-me-with-another-at-least-32-chars-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173

# ─── WorkOS (Enterprise SSO/SCIM — get test keys from dashboard.workos.com) ───
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ─── Stripe (Billing — get test keys from dashboard.stripe.com) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# For local dev, you can use MinIO or skip file upload features
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=  # Leave blank for AWS S3; set for R2 (https://accountid.r2.cloudflarestorage.com) or MinIO
