# ─── Infrastructure mode (read by scripts/dev.sh, stop.sh, doctor.sh) ──────────
# local  (default) — Postgres+Redis come from docker-compose.yml via Docker.
# remote           — No Docker; DATABASE_URL/REDIS_URL point at cloud services.
# `bun run test` still needs local Docker for DATABASE_TEST_URL on :5433.
INFRA_MODE=local

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test
# Connections per backend instance (the whole DB concurrency budget for a
# process — no read-replica routing). Total across the fleet is this × replicas.
DATABASE_POOL_MAX=5

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Upstash: REDIS_URL=rediss://default:<password>@<host>:6379 (TLS auto-enabled
# for *.upstash.io). Must be exactly "false" to enable Redis.
REDIS_DISABLED=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace these with long random strings in your actual .env
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=replace-me-with-another-at-least-32-chars-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Sliding refresh windows: idle extends on rotation, absolute never does.
# Legacy REFRESH_TOKEN_EXPIRES_IN above is a fallback for one release.
REFRESH_IDLE_EXPIRES_IN=7d
REFRESH_ABSOLUTE_EXPIRES_IN=30d
REFRESH_REUSE_GRACE_SECONDS=10
REFRESH_GRACE_MAX_USES=2
# Optional stricter caps for platform super-admins (unset = main values).
# SUPERADMIN_REFRESH_IDLE_EXPIRES_IN=30m
# SUPERADMIN_REFRESH_ABSOLUTE_EXPIRES_IN=24h

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173,http://localhost:5174

# ─── WorkOS (Enterprise SSO & Google OAuth — get keys from dashboard.workos.com) ───
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_WEBHOOK_SECRET=

# ─── Google Calendar sync (direct Calendar API — console.cloud.google.com/apis/credentials) ───
# Create an OAuth 2.0 Client (Web app) with redirect URI http://localhost:3001/v1/calendar/google/callback
# Refresh tokens are AES-GCM encrypted at rest with CALENDAR_TOKEN_KEY (generate: openssl rand -base64 32)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/calendar/google/callback
CALENDAR_TOKEN_KEY=

# ─── Stripe (Billing — get test keys from dashboard.stripe.com) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_biz_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_biz_annual
STRIPE_GUEST_OVERAGE_PRICE_ID=price_guest_overage

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# For local dev, you can use MinIO or skip file upload features
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=  # Leave blank for AWS S3; set for R2 (https://accountid.r2.cloudflarestorage.com) or MinIO

# ─── Media virus scan (5.5, fail-closed ClamAV sidecar) ───────────────────────
# disabled = uploads skip scanning (dev/test only; refused in production).
# Start the sidecar with: docker compose --profile scan up -d clamav
SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCAN_CONCURRENCY=4
SCAN_MAX_ATTEMPTS=5
SCAN_TIMEOUT_MS=60000
# Bounded daily batch that re-scans pre-gate (legacy) attachments.
LEGACY_RESCAN_MS=86400000
LEGACY_RESCAN_BATCH=25

# ─── Inbound email (4.6b) ────────────────────────────────────────────────────
# Generic forwarder webhook HMAC secret (SendGrid/Mailgun style). SES→SNS is
# verified by signature instead and needs no secret.
INBOUND_WEBHOOK_SECRET=
# Domain that receives mail and appears in Reply-To / Message-ID.
INBOUND_DOMAIN=reply.boardly.app
# HMAC secret deriving each card's reply address. Blank = inbound works, but
# notification mail sends without threading.
INBOUND_TOKEN_SECRET=

# ─── Email & Onboarding (Transactional) ────────────────────────────────────────
# Leave blank for local dev mode (emails will print directly to the backend terminal)
APP_URL=http://localhost:5173
EMAIL_FROM=Boardly <noreply@boardly.app>

# Option 1: Resend (Primary Provider — get API key from resend.com)
RESEND_API_KEY=

# Option 2: Amazon SES (Fallback 1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# Option 3: Personal SMTP Server (Fallback 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=


# ─── Seed safety ───
# Demo seed refuses NODE_ENV=production unless this is explicitly "1".
# BOARDLY_SEED_PRODUCTION=1
