{
  "name": "boardly",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "./scripts/dev.sh",
    "dev": "./scripts/dev.sh",
    "dev:turbo": "turbo run dev",
    "setup": "./scripts/setup.sh",
    "stop": "./scripts/stop.sh",
    "doctor": "./scripts/doctor.sh",
    "db:up": "./scripts/db.sh up",
    "db:down": "./scripts/db.sh down",
    "db:status": "./scripts/db.sh status",
    "db:migrate": "./scripts/db.sh migrate",
    "db:seed": "./scripts/db.sh seed",
    "db:reset": "./scripts/db.sh reset",
    "db:studio": "./scripts/db.sh studio",
    "db:logs": "./scripts/db.sh logs",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:db-cli": "./scripts/db.sh.test.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "oxlint": "^1.78.0",
    "prettier": "^3.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}
