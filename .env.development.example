# ─── Boardly — DEVELOPMENT ───────────────────────────────────────────────────
# Copy to .env.development for local use: cp .env.development.example .env.development
# Loaded by ./scripts/dev.sh (root .env.development → apps/backend/.env)

# ─── Infrastructure mode (read by scripts/dev.sh, stop.sh, doctor.sh) ──────────
# local  (default) — Docker Desktop/OrbStack runs Postgres+Redis from
#                    docker-compose.yml. DATABASE_URL/REDIS_URL point at localhost.
# remote           — No Docker required. DATABASE_URL/REDIS_URL point at cloud
#                    services (Neon, Upstash, RDS). `bun run dev` skips every
#                    docker step and probes reachability of the configured hosts.
#                    NOTE: `bun run test` still needs local Docker — the backend
#                    suite connects to DATABASE_TEST_URL on :5433.
# Any other value is a hard error, so a typo cannot silently select a mode.
INFRA_MODE=local

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (INFRA_MODE=local: see docker-compose.yml; remote: your cloud URL) ─
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test

# ─── Redis (INFRA_MODE=local: localhost; remote: your cloud URL) ────────────────
REDIS_URL=redis://localhost:6379
# Upstash: REDIS_URL=rediss://default:<password>@<host>:6379 (TLS auto-enabled
# for *.upstash.io). Must be exactly "false" to enable Redis.
REDIS_DISABLED=false

# ─── Auth (dev-only secrets — never reuse in production) ──────────────────────
JWT_SECRET=dev-only-replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=dev-only-replace-me-with-another-32-chars-minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
EMAIL_FROM="Boardly <noreply@boardly.app>"

# ─── WorkOS / Stripe (empty = skipped in dev) ─────────────────────────────────
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_WEBHOOK_SECRET=

# ─── Google Calendar sync (direct Calendar API — console.cloud.google.com/apis/credentials) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_TOKEN_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_biz_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_biz_annual
STRIPE_GUEST_OVERAGE_PRICE_ID=price_guest_overage

# ─── Storage (empty = local uploads/ fallback) ────────────────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ─── Email (empty = console log to backend terminal) ──────────────────────────
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
