{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "App.tsx", "index.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "node_modules"]
}
