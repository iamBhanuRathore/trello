# ─── Super Admin Environment Variables ───────────────────────────────────────
VITE_API_URL=http://localhost:3001/v1

# ─── Error Monitoring (Sentry) ──────────────────────────────────────────────
# Separate Sentry project from the customer dashboard so platform-admin
# events never mix with end-user traffic. Empty disables entirely.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENABLED=false
# Must equal the backend's GIT_SHA for the deployed commit.
# VITE_GIT_SHA=
