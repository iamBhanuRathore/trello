# ─── Dashboard Environment Variables ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001/v1

# ─── Error Monitoring (Sentry) ──────────────────────────────────────────────
# Leave VITE_SENTRY_DSN empty and the SDK never initializes — dev and CI stay
# silent with no network calls. Public DSN: safe to ship, it only accepts events.
# VITE_SENTRY_DSN=
# Force the client on in a non-production build for staging smoke tests.
# VITE_SENTRY_ENABLED=false
# Release identity. Set by CI from the same commit sha the backend uses
# (GIT_SHA) so uploaded sourcemaps match the events they deobfuscate.
# VITE_GIT_SHA=
