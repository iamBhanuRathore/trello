{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  // Release identity for error monitoring. Vercel does not export GITHUB_SHA
  // under a VITE_ name, and turbo strips any var absent from build.env, so the
  // sha is mapped explicitly here. Must be byte-identical to the backend's
  // GIT_SHA at deploy time, or a phase-2 sourcemap upload will not deobfuscate
  // the events it was uploaded for. Keep it in sync with turbo.json build.env.
  "build": {
    "env": {
      "VITE_GIT_SHA": "@github.sha"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://trello-yq9e.onrender.com wss://trello-yq9e.onrender.com https://api.mymemory.translated.net; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=86400" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
