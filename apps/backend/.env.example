# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local Docker:
REDIS_URL=redis://localhost:6379
# Upstash (Singapore recommended for IN/SG): paste the TCP endpoint from the
# Upstash dashboard (rediss://default:<password>@<host>:6379). The client
# auto-enables TLS for *.upstash.io hosts, so a redis:// URL works too.
# REDIS_URL=rediss://default:<password>@<host>:6379
# Must be exactly "false" to enable Redis ("true"/"1" disables it).
REDIS_DISABLED=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace these with long random strings in your actual .env
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=replace-me-with-another-at-least-32-chars-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173,http://localhost:5174

# ─── WorkOS (Enterprise SSO & Google OAuth — get keys from dashboard.workos.com) ───
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_WEBHOOK_SECRET=

# ─── Google Calendar sync (direct Calendar API — console.cloud.google.com/apis/credentials) ───
# Create an OAuth 2.0 Client (Web app) with redirect URI http://localhost:3001/v1/calendar/google/callback
# Refresh tokens are AES-GCM encrypted at rest with CALENDAR_TOKEN_KEY (generate: openssl rand -base64 32)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/calendar/google/callback
CALENDAR_TOKEN_KEY=

# ─── Stripe (Billing — get test keys from dashboard.stripe.com) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_biz_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_biz_annual
STRIPE_GUEST_OVERAGE_PRICE_ID=price_guest_overage

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# For local dev, you can use MinIO or skip file upload features
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=  # Leave blank for AWS S3; set for R2 (https://accountid.r2.cloudflarestorage.com) or MinIO

# ─── Media virus scan (5.5, fail-closed ClamAV sidecar) ───────────────────────
# disabled = uploads skip scanning and serve immediately (dev/test only; the
# backend refuses to boot reads with disabled in production).
# enabled = bytes stream to clamd INSTREAM; only clean rows are servable.
# Start the sidecar with: docker compose --profile scan up -d clamav
SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCAN_CONCURRENCY=4
SCAN_MAX_ATTEMPTS=5
SCAN_TIMEOUT_MS=60000
# S3 lifecycle on the upload prefix (orgs/*) is the GC backstop; the app cron
# owns precise deletes. Terraform/bucket note: expire orgs/* staging keys >1d.
MEDIA_GC_STAGED_HOURS=24
MEDIA_GC_FAILED_DAYS=7

# ─── Inbound email (4.6b) ─────────────────────────────────────────────────────
# Generic forwarder webhook HMAC secret (SendGrid/Mailgun-style). SES→SNS uses
# signature verification instead (no secret needed).
INBOUND_WEBHOOK_SECRET=
# Domain in Reply-To / Message-ID threading headers (must receive mail).
INBOUND_DOMAIN=reply.boardly.app
# HMAC secret that derives each card's reply address (board+<token>@INBOUND_DOMAIN).
# Without it inbound still works; outbound notification mail sends unthreaded.
INBOUND_TOKEN_SECRET=change-me-32-bytes-min

# ─── Email & Onboarding (Transactional) ────────────────────────────────────────
# Leave blank for local dev mode (emails will print directly to the backend terminal)
APP_URL=http://localhost:5173
EMAIL_FROM=Boardly <noreply@boardly.app>

# Option 1: Resend (Primary Provider — get API key from resend.com)
RESEND_API_KEY=

# Option 2: Amazon SES (Fallback 1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# Option 3: Personal SMTP Server (Fallback 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

