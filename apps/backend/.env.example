# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace these with long random strings in your actual .env
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=replace-me-with-another-at-least-32-chars-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173,http://localhost:5174

# ─── WorkOS (Enterprise SSO & Google OAuth — get keys from dashboard.workos.com) ───
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_WEBHOOK_SECRET=

# ─── Stripe (Billing — get test keys from dashboard.stripe.com) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# For local dev, you can use MinIO or skip file upload features
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=  # Leave blank for AWS S3; set for R2 (https://accountid.r2.cloudflarestorage.com) or MinIO

# ─── Email & Onboarding (Transactional) ────────────────────────────────────────
# Leave blank for local dev mode (emails will print directly to the backend terminal)
APP_URL=http://localhost:5173
EMAIL_FROM=Boardly <noreply@boardly.app>

# Option 1: Amazon SES (Primary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# Option 2: SMTP Transport (Fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
