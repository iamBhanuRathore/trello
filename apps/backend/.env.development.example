# ─── Boardly — DEVELOPMENT (local Docker) ───────────────────────────────────
# Copy to .env.development for local use: cp .env.development.example .env.development
# Loaded by ./scripts/dev.sh (root .env.development → apps/backend/.env)

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (local Docker, see docker-compose.yml) ──────────────────────────
DATABASE_URL=postgresql://boardly:boardly_dev@localhost:5432/boardly_dev
DATABASE_TEST_URL=postgresql://boardly:boardly_test@localhost:5433/boardly_test

# ─── Redis (local Docker) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false

# ─── Auth (dev-only secrets — never reuse in production) ──────────────────────
JWT_SECRET=dev-only-replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=dev-only-replace-me-with-another-32-chars-minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
EMAIL_FROM=Boardly <noreply@boardly.app>

# ─── WorkOS / Stripe (empty = skipped in dev) ─────────────────────────────────
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_biz_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_biz_annual
STRIPE_GUEST_OVERAGE_PRICE_ID=price_guest_overage

# ─── Storage (empty = local uploads/ fallback) ────────────────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ─── Email (empty = console log to backend terminal) ──────────────────────────
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
