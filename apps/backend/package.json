{
  "name": "@boardly/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:org": "bun run src/db/seedOrganization.ts",
    "db:reset": "bun run src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@boardly/shared-types": "workspace:*",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@workos-inc/node": "^10.12.0",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.29",
    "jose": "^5.10.0",
    "nodemailer": "^9.0.6",
    "postgres": "^3.4.9",
    "resend": "^6.25.0",
    "stripe": "^22.6.0",
    "uuid": "^14.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@boardly/config": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
