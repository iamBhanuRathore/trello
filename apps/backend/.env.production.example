# ─── Boardly — PRODUCTION (Render + Neon + B2) ────────────────────────────────
# DO NOT commit real secrets. On Render, paste these as Environment Variables
# (Dashboard → Service → Environment), not as a file.
# Template: cp .env.production.example .env.production (local dry-run only)

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database (Neon pooled string — REQUIRED) ─────────────────────────────────
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/boardly?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.<region>.aws.neon.tech/boardly?sslmode=require
# Leave empty unless you have a read replica
# DATABASE_REPLICA_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
# Single Render Free instance → in-memory fallback is fine:
REDIS_DISABLED=true
# Multi-instance or presence across restarts → Upstash Redis:
# REDIS_DISABLED=false
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ─── Auth (REQUIRED — generate fresh, never reuse dev values) ─────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-chars-of-random-data
REFRESH_TOKEN_SECRET=replace-me-with-another-at-least-32-chars-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── App URLs (REQUIRED — no localhost) ───────────────────────────────────────
# Example: API_URL=https://trello-yq9e.onrender.com
API_URL=https://trello-yq9e.onrender.com
DASHBOARD_URL=https://trello-dashboard-sepia.vercel.app
APP_URL=https://trello-dashboard-sepia.vercel.app
EMAIL_FROM=Boardly <noreply@yourdomain.com>

# ─── WorkOS / Stripe (fill when enabling SSO / billing) ───────────────────────
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=https://trello-dashboard-sepia.vercel.app/auth/callback
WORKOS_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_GUEST_OVERAGE_PRICE_ID=

# ─── Storage (Backblaze B2 free 10GB — REQUIRED for persistent uploads) ───────
# Render's filesystem is ephemeral; empty values = uploads lost on restart.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com

# ─── Email (Resend recommended) ───────────────────────────────────────────────
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Error monitoring
SENTRY_DSN=
SENTRY_ENABLED=false
# Injected by Helm from the image tag — do not set by hand.
GIT_SHA=
